# Copy this file to .env and fill in your values
# cp .env.example .env

# Google Maps Static API key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "Maps Static API" in the API library
# The free tier covers ~28,000 map loads/month — more than enough for MVP
GOOGLE_MAPS_API_KEY=your_key_here

# Database (these match docker-compose.yml defaults — only change if running without Docker)
DATABASE_URL=postgresql://dclens:dclens_dev@localhost:5432/dclens
